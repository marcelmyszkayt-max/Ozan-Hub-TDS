local autoSkip = false
local skipError = ""
local skipCount = 0
local skipKey = ""
local skipRetryAt = 0
local voteFolder: Instance? = nil
local voteReplicator: any = nil
local releaseVote: any = nil
local Collection = game:GetService("CollectionService")
local TagReplicator: any = loadModule(ReplicatedStorage.Client.Modules.TagReplicator)
local Voting = loadModule(ReplicatedStorage.Shared.Modules.Network).Channel("Voting")
local function releaseVoting()
    if releaseVote then releaseVote() end
    releaseVote = nil
    voteReplicator = nil
    voteFolder = nil
end
local function skipStep()
    if not autoSkip or not alive or Fluent.Unloaded or GameState.GameOver then return end
    local current = Collection:GetTagged("VoteManager")[1]
    if current ~= voteFolder then
        releaseVoting()
        voteFolder = current
        if current then voteReplicator, releaseVote = TagReplicator.acquireReplicatorEntityFromFolder(current) end
    end
    if not voteReplicator or not voteReplicator:Get("Enabled") then return end
    local title = tostring(voteReplicator:Get("Title") or ""):lower()
    if not title:find("skip", 1, true) or title:find("cutscene", 1, true) or title:find("restart", 1, true) then return end
    if not GameState.GameStarted or (tonumber(GameState.Wave) or 0) < 1 or GameState.VotingForMap then return end
    for _, field in ipairs({"YesVoted", "NoVoted"}) do
        for _, id in pairs(voteReplicator:Get(field) or {}) do
            if tonumber(id) == localPlayer.UserId then return end
        end
    end
    local key = tostring(GameState.Wave) .. ":" .. tostring(voteReplicator:Get("VoteEnd")) .. ":" .. title
    if key == skipKey or os.clock() < skipRetryAt then return end
    skipRetryAt = os.clock() + 5
    local accepted, reason = Voting:InvokeServer("Skip")
    if accepted == false then error(tostring(reason or "Skip vote was not accepted.")) end
    skipKey = key
    skipCount += 1
end
runtime.onCleanup(function()
    autoSkip = false
    releaseVoting()
end)
task.spawn(function()
    while alive and not Fluent.Unloaded do
        if autoSkip then
            local ok, issue = pcall(skipStep)
            skipError = if ok then "" else tostring(issue)
        end
        task.wait(0.5)
    end
    releaseVoting()
end)

local autoAbilities = false
local abilityError = ""
local AbilitiesStore: any = loadModule(ReplicatedStorage.Client.Interfaces.Stores.Game.AbilitiesStore)
local AbilityAmmoStore: any = loadModule(ReplicatedStorage.Client.Interfaces.Stores.Game.AbilityAmmoStore)
local LockedAbilitiesStore: any = loadModule(ReplicatedStorage.Client.Interfaces.Stores.Game.LockedAbilitiesStore)
local ClientAtoms: any = loadModule(ReplicatedStorage.Shared.Modules.ClientAtoms)
local ServerTicks: any = loadModule(ReplicatedStorage.Shared.Modules.ServerTicks)
local TowerUpgradeUtils: any = loadModule(ReplicatedStorage.Shared.Modules.TowerUpgradeUtils)
local abilityRetry: {[string]: number} = {}
local function abilitiesStep(force: boolean?, checkPrice: boolean?)
    if (not autoAbilities and not force) or not alive or Fluent.Unloaded or not GameState.GameStarted or GameState.GameOver then return false end
    if ClientAtoms.cloneTowerAtom().blockOtherAbilities then return false end
    local cooldowns = AbilitiesStore.getState()
    local ammunition = AbilityAmmoStore.getState()
    local locked = LockedAbilitiesStore.getState()
    local now = ServerTicks.getTime()
    for _, tower in pairs(TowerReplicator.getTowers()) do
        if tower.OwnerId ~= localPlayer.UserId or not tower.Model or not tower.Model.Parent or not tower.Maid then continue end
        local disabled = tower.Replicator:Get("DisabledAbilities") or {}
        local level = tonumber(tower.Replicator:Get("Upgrade")) or 0
        local path = tonumber(tower.Replicator:Get("Path")) or 0
        for _, ability in pairs(tower.AvailableAbilities or {}) do
            local name = ability.Name
            local owner = PlayerReplicator.GetLocalPlayerRaw()
            if checkPrice and (tonumber(ability.Price) or 0) > (owner and tonumber(owner.Replicator:Get("Cash")) or 0) then continue end
            if type(name) ~= "string" or level < (tonumber(ability.Level) or 0) or not TowerUpgradeUtils.matchesPath(ability, path) then continue end
            if disabled[name] or locked[name] or (tower.AbilityCallbacks and tower.AbilityCallbacks[name]) then continue end
            local formatted = name:gsub("[^%w]", "")
            local state = cooldowns[tower.Model] and cooldowns[tower.Model][formatted]
            if not state or (tonumber(state.deltaTime) or 0) > now then continue end
            local ammo = ammunition[name .. tostring(tower.UID)]
            if ammo and ammo.ammo ~= nil and ammo.ammo <= 0 then continue end
            local key = tostring(tower.UID) .. ":" .. name
            if (abilityRetry[key] or 0) > os.clock() then continue end
            if (not autoAbilities and not force) or not alive or Fluent.Unloaded then return false end
            abilityRetry[key] = os.clock() + 3
            local accepted, reason = Troops:InvokeServer("Abilities", "Activate", {Name = name, Troop = tower.Model, Data = {}})
            if accepted == false then
                abilityRetry[key] = os.clock() + 15
                abilityError = tostring(reason or "Ability activation was not accepted.")
            else
                abilityError = ""
            end
            return true, name, tower.UID, accepted, reason
        end
    end
    return false
end
runtime.onCleanup(function()
    autoAbilities = false
    table.clear(abilityRetry)
end)
task.spawn(function()
    while alive and not Fluent.Unloaded do
        if autoAbilities then
            local ok, problem = pcall(abilitiesStep)
            if not ok then abilityError = tostring(problem) end
        end
        task.wait(0.5)
    end
end)

