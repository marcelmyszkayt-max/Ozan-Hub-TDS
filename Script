        for _, def in ipairs(model.defs) do
            if def.kind ~= "damage" or limits[def.name] >= def.stages[1].limit then continue end
            if not selected or limits[def.name] < limits[selected.name] then selected = def end
        end
        if not selected then break end
        limits[selected.name] += 1
        remaining -= 1
    end
    for _, upgrade in ipairs({0.8, 1.3, 2}) do
        table.insert(result, {label = "Mixed loadout", limits = limits, upgrade = upgrade, place = 1, buildRate = 1.5, earlyCap = 2, site = 1, hiddenPenalty = 0.35, saveSeconds = if upgrade < 1 then 0 else 120, savePatience = 60, supportAt = 4})
    end
