local function plannerSites(asset: any, stages: any, routes: any, team: any, token: number): any
    local surfaces = advisorSurfaces(asset.Properties.Class)
    local largest = 0
    for _, stage in ipairs(stages) do largest = math.max(largest, stage.range) end
    local ranked, seen = {}, {}
    local function spanLength(spans: any, after: number?): number
        local amount = 0
        for _, span in ipairs(spans or {}) do amount += math.max(0, span[2] - math.max(span[1], after or 0)) end
        return amount
    end
    local function add(x: number, z: number)
        local key = math.round(x) .. ":" .. math.round(z)
        if seen[key] then return end
        seen[key] = true
        local point = advisorProject(x, z, surfaces)
        if not point then return end
        local base = StrategyModel.intervals(point, stages[1].range, stages[1].deadzone, routes)
        local maximum = StrategyModel.intervals(point, largest, stages[#stages].deadzone, routes)
        local scores, late, total, balance = {}, {}, 0, math.huge
        for index, route in ipairs(routes) do
            scores[index] = spanLength(base[index]) * 0.6 + spanLength(maximum[index]) * 0.4
            late[index] = spanLength(maximum[index], route.length * 0.7)
            total += scores[index]
            balance = math.min(balance, scores[index] / route.length)
        end
        if total > 0 then table.insert(ranked, {point = point, score = total / #routes, scores = scores, late = late, balance = balance}) end
    end
    for _, route in ipairs(routes) do
        local count = math.max(16, math.min(50, math.ceil(route.length / math.max(4, largest * 0.3))))
        for index = 0, count do
            local point = route.path:GetScalar(route.length * index / count)
            add(point.X, point.Z)
            for _, factor in ipairs({0.45, 0.8}) do
                for angle = 0, 7 do
                    local theta = angle * math.pi / 4
                    add(point.X + math.cos(theta) * largest * factor, point.Z + math.sin(theta) * largest * factor)
                end
            end
            if index % 5 == 0 then plannerCheck(token) end
        end
    end
    for index, part in ipairs(surfaces.parts) do
        add(part.Position.X, part.Position.Z)
        if index % 40 == 0 then plannerCheck(token) end
    end
    local sites, chosen, validity = {}, {}, {}
    local function insert(candidate: any, apart: number): boolean
        if chosen[candidate] then return false end
        for _, site in ipairs(sites) do if (site.point - candidate.point).Magnitude < apart then return false end end
        if validity[candidate] == nil then validity[candidate] = validateAdvisorPoint(asset.Name or "", candidate.point, team) ~= nil end
        if not validity[candidate] then return false end
        local intervals = {}
        for level, stage in ipairs(stages) do
            intervals[level] = StrategyModel.intervals(candidate.point, stage.range, stage.deadzone, routes)
            if stage.globalUnits then
                intervals[level] = {}
                for routeIndex, route in ipairs(routes) do intervals[level][routeIndex] = {{0, route.length}} end
            end
        end
        table.insert(sites, {point = candidate.point, intervals = intervals, score = candidate.score})
        chosen[candidate] = true
        return true
    end
    local function choose(score: any, count: number, apart: number)
        table.sort(ranked, function(a, b) return score(a) > score(b) end)
        local added = 0
        for index, candidate in ipairs(ranked) do
            if score(candidate) <= 0 then break end
            if insert(candidate, apart) then added += 1 end
            if added >= count or index >= 60 then break end
        end
        plannerCheck(token)
    end
    if #routes > 1 then
        choose(function(candidate: any) return candidate.balance end, 1, 1)
        for route in ipairs(routes) do choose(function(candidate: any) return candidate.scores[route] end, 1, 2) end
    end
    choose(function(candidate: any) return candidate.score end, if #routes > 1 then 3 else 5, math.max(3, largest * 0.2))
    for route in ipairs(routes) do choose(function(candidate: any) return candidate.late[route] end, 1, 2) end
    return sites
end
