        local remaining = plannerRemainingRoutes(plan.model, enemies)
        for _, tower in ipairs(towers) do
            if not planner.owned[tower.live.Model] or tower.def.kind == "support" then continue end
            local stage = tower.def.stages[tower.level + 1]
            local intervals = tower.def.sites[tower.site].intervals[tower.level + 1]
            if tower.def.kind == "economy" or (stage.unitDps == 0 and StrategyModel.coverage(intervals, plan.model.routes, remaining) <= 0) then
                local key = "sell:" .. tostring(tower.live.UID)
                if (planner.retry[key] or 0) > os.clock() then continue end
                planner.retry[key] = os.clock() + 5
