local function checkHubPlacement(name: any, position: any, team: any, extra: any, ignored: any, radius: any)
    if not alive or Fluent.Unloaded or typeof(position) ~= "Vector3" or (not enabled and not wallPlacement) then
        return baseCheck(name, position, team, extra, ignored, radius)
    end
    local height = if enabled then 10 else 0
    local valid, hit = baseCheck(name, position + Vector3.new(0, height, 0), team, extra, ignored, radius)
    local sameSurface = valid and typeof(hit) == "RaycastResult" and math.abs(hit.Position.Y - position.Y) <= 0.5
    if valid and typeof(hit) == "RaycastResult" and (not wallPlacement or sameSurface) then
        if height == 0 then return valid, hit end
        return true, placementResult(hit, height)
    end
    if not wallPlacement then return valid, hit end
    local obstacles = wallObstacles(position, extra, ignored)
    local function tryOffset(candidate: number): any
        local accepted, surface = baseCheck(name, position + Vector3.new(0, candidate, 0), team, obstacles, ignored, radius)
        if accepted and typeof(surface) == "RaycastResult" and math.abs(surface.Position.Y - position.Y) <= 0.5 then
