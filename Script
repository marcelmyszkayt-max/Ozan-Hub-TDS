                table.insert(result, {label = "Focused value", upgrade = upgrade, place = 1, buildRate = buildRate, earlyCap = 2, site = site, hiddenPenalty = 0.35, saveSeconds = if upgrade > 1 then 18 else 0, supportAt = if upgrade > 1 then 5 else 100})
