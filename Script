        local favorite = if favoriteIndex > 0 then names[favoriteIndex] else nil
        add({label = if mixed then "Mixed loadout" else if favorite then "Tower focus: " .. favorite else "Focused value", limits = if mixed then limits else nil, upgrade = upgrades[index % #upgrades + 1], place = 1, buildRate = builds[(index * 2) % #builds + 1], earlyCap = early[(index * 2) % #early + 1], site = (index * 5 + math.floor(index / 7)) % maxSites + 1, hiddenPenalty = 0.35, saveSeconds = savings[(index * 3) % #savings + 1], savePatience = if index % 2 == 0 then 60 else 30, supportAt = ({3, 5, 10, 100})[(index + math.floor(index / 11)) % 4 + 1], favorite = favorite, favoriteWeight = if favorite then ({1.2, 1.7, 2.5})[(index + math.floor(index / 3)) % 3 + 1] else nil})
