end
local plannerReadyRetry = 0
local function plannerVote(ready: boolean)
    if os.clock() < plannerReadyRetry then return end
    local rep = plannerVoting()
    if not rep or not rep:Get("Enabled") then return end
    local title = tostring(rep:Get("Title") or ""):lower()
    if ready then
        if (tonumber(GameState.Wave) or 0) ~= 0 or GameState.VotingForMap or title:find("restart", 1, true) or title:find("cutscene", 1, true) then return end
    elseif not title:find("skip", 1, true) then return end
    for _, field in ipairs({"YesVoted", "NoVoted"}) do
        for _, id in pairs(rep:Get(field) or {}) do
            if tonumber(id) == localPlayer.UserId then return end
        end
    end
    plannerReadyRetry = os.clock() + 4
    local accepted, reason = Voting:InvokeServer("Skip")
    plannerLog("vote", {accepted = accepted ~= false, reason = tostring(reason or ""), ready = ready})
end
local function plannerAct()
