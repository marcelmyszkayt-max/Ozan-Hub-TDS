    local startPosition = Vector2.zero
    local moved = false
    local suppressUntil = 0
    local function link(signal: RBXScriptSignal, callback: any)
        table.insert(connections, signal:Connect(callback))
    end
    local function dispose()
        if disposed then return end
        disposed = true
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
        screen:Destroy()
    end
    link(button.InputBegan, function(input: InputObject)
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if pointer then return end
        pointer = input
        startPoint = Vector2.new(input.Position.X, input.Position.Y)
        local inset = game:GetService("GuiService"):GetGuiInset()
        startPosition = button.AbsolutePosition - inset
        moved = false
    end)
    link(inputService.InputChanged, function(input: InputObject)
        if not pointer then return end
        local tracked = input == pointer or (pointer.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if not tracked then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - startPoint
        if delta.Magnitude < 8 and not moved then return end
        moved = true
        local camera = workspace.CurrentCamera
        local view = if camera then camera.ViewportSize else Vector2.new(800, 600)
        local position = startPosition + delta
        button.Position = UDim2.fromOffset(math.clamp(position.X, 8, math.max(8, view.X - 82)), math.clamp(position.Y, 8, math.max(8, view.Y - 92)))
    end)
    link(inputService.InputEnded, function(input: InputObject)
        if input ~= pointer then return end
        pointer = nil
        if moved then suppressUntil = os.clock() + 0.25 end
    end)
    link(button.Activated, function()
        if disposed or moved or os.clock() < suppressUntil then return end
        if Fluent.Unloaded then dispose(); return end
        Window:Minimize()
    end)
    local camera = workspace.CurrentCamera
