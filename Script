                local near = 0
                for _, tower in ipairs(towers) do if (tower.def.sites[tower.site].point - site.point).Magnitude <= maximum.range then near += 1 end end
                score = near * 0.035
            end
            if def.kind == "economy" then score = stage.income * math.max(0, 25 - wave) / math.max(1, def.price) * 0.08 end
            offer({kind = "place", def = def, site = siteIndex, level = 0, cost = def.price}, score)
        end
    end
    if reserve and (not best or reserve.score > best.score * 1.15) then return nil end
    return best
end
function StrategyModel.simulate(model: any, policy: any, stress: any, checkpoint: any): any
    local dt = 0.4
    local time = 0
    local cash = model.startCash
    local health = model.startHealth
    local towers, enemies, log, puddles = {}, {}, {}, {}
    local bossModel = model.profile.boss or {}
    local summon = bossModel.summon or {first = 45, interval = 45, count = 5, pause = 2.5}
    local stomp = bossModel.stomp or {first = 55, interval = 55, radius = 30, stun = 5, pause = 3, flying = 3}
    local flask = bossModel.flask or {first = 30, interval = 30, ahead = 12, radius = 9, duration = 30, healingPerSecond = 100, pause = 3}
    local toxic = bossModel.toxic or {first = 45, interval = 45, radius = 28, splash = 5, duration = 10, cooldownMultiplier = 2.5, targets = 4, pause = 5}
    local rage = bossModel.rage or {healthFraction = 0.5, speedMultiplier = 1.6, pause = 4, healingPerSecond = 750, healingDuration = 4}
    local wave = 0
    local waveStart, nextPurchase = 0, 0
    local spawnIndex = 1
    local waveReady = false
    local lastClear = -1
    local waveLeaked = 0
    local killed, leaked, cleared = 0, 0, 0
    local bossRemaining = 0
    local bossActions = {summon = 0, stomp = 0, flask = 0, toxic = 0, rage = 0}
