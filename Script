local StrategyController = (function()
local StrategyModel: any = {}
function StrategyModel.merge(base: any, change: any): any
    local result = table.clone(base or {})
    for key, value in pairs(change or {}) do
        result[key] = if type(value) == "table" and type(result[key]) == "table" then StrategyModel.merge(result[key], value) else value
    end
    return result
end
function StrategyModel.stage(stats: any, name: string, cost: number, invested: number, adjustRange: any): any
    local attrs = stats.Attributes or {}
    local range = adjustRange(tonumber(stats.Range) or 0)
    local damage = tonumber(stats.Damage) or tonumber(attrs.Damage) or 0
    local cooldown = math.max(0.04, tonumber(stats.Cooldown) or tonumber(attrs.Cooldown) or 1)
    local pellets = tonumber(attrs.ShotSize) or 1
    local burst = tonumber(attrs.BurstCount) or tonumber(attrs.BurstAmount) or 1
    local dps = damage / cooldown * math.max(1, pellets * 0.55) * math.max(1, burst * 0.65)
    local warning: string? = nil
    if attrs.ChargeTime or attrs.RevTime or attrs.Ammo or attrs.MaxAmmo then dps *= 0.7; warning = "charge, spool or reload approximation" end
    local unitDps = tonumber(stats._UnitDps) or 0
    if attrs.PistolCrookSpawnTime then unitDps += math.min(3, tonumber(attrs.PistolCrookCap) or 3) * 5 * 0.4 end
    if attrs.TommyCrookSpawnTime then unitDps += math.min(2, tonumber(attrs.TommyCrookCap) or 2) * 25 * 0.4 end
    if pellets > 1 then warning = "pellet spread and piercing are approximated" end
    if unitDps > 0 then warning = "spawned units are conservatively approximated" end
    if name == "DJ Booth" then dps = 0 end
    if name == "Commander" then warning = "support ability benefits are not fully simulated" end
    if damage == 0 and unitDps == 0 and (tonumber(stats.Income) or 0) == 0 and name ~= "DJ Booth" and name ~= "Commander" then warning = "utility or production mechanics are not fully modeled" end
    return {range = range, deadzone = math.max(0, tonumber(attrs.Deadzone) or 0), damage = damage, dps = dps, unitDps = unitDps, pierce = if pellets > 1 then 3 else 1, spread = tonumber(attrs.Spread) or 0, globalUnits = stats._GlobalUnits == true, income = tonumber(stats.Income) or 0, cooldown = cooldown, cost = cost, invested = invested, hidden = stats.Detections and stats.Detections.HiddenDetection == true, flying = stats.Detections and stats.Detections.FlyingDetection == true, lead = stats.Detections and stats.Detections.LeadDetection == true, splash = tonumber(attrs.ExplosionRadius) or tonumber(attrs.SplashRadius) or 0, limit = tonumber(stats.Limit) or 40, attrs = attrs, warning = warning}
end
function StrategyModel.intervals(point: Vector3, radius: number, minimum: number, routes: {any}): any
    local all = {}
    for index, route in ipairs(routes) do
        local intervals = {}
        for _, segment in ipairs(route.segments) do
            local f = segment.a - point
            local b = 2 * f:Dot(segment.d)
            local function bounds(r: number): (number, number)
                local disc = b * b - 4 * segment.square * (f:Dot(f) - r * r)
                if disc <= 0 or r <= 0 then return 0, 0 end
                local root = math.sqrt(disc)
                return math.clamp((-b - root) / (2 * segment.square), 0, 1), math.clamp((-b + root) / (2 * segment.square), 0, 1)
            end
            local enter, leave = bounds(radius)
            local ia, ib = bounds(math.min(radius, minimum))
            ia, ib = math.max(enter, ia), math.min(leave, ib)
            local function add(a: number, z: number)
                if z <= a then return end
                local first, last = segment.start + a * segment.length, segment.start + z * segment.length
                local previous = intervals[#intervals]
                if previous and first <= previous[2] + 0.0001 then previous[2] = math.max(previous[2], last)
                else table.insert(intervals, {first, last}) end
            end
            if ib > ia then add(enter, ia); add(ib, leave) else add(enter, leave) end
        end
        all[index] = intervals
    end
    return all
end
function StrategyModel.contains(intervals: any, route: number, distance: number): boolean
    for _, span in ipairs(intervals[route] or {}) do if distance >= span[1] and distance <= span[2] then return true end end
    return false
end
function StrategyModel.coverage(intervals: any, routes: {any}, after: any?): number
    local amount = 0
    for index in ipairs(routes) do
        local threshold = if type(after) == "table" then after[index] or 0 else after or 0
        for _, span in ipairs(intervals[index] or {}) do amount += math.max(0, span[2] - math.max(span[1], threshold)) end
    end
    return amount / math.max(1, #routes)
end
function StrategyModel.spectra(profile: any): any
    local result = {}
    for wave = 1, #profile.waves do
        local total, hidden, flying, lead = 0, 0, 0, 0
        for future = wave, math.min(#profile.waves, wave + 1) do
            for _, entry in ipairs(profile.waves[future]) do
                local enemy = profile.types[entry[2]]
                local weight = math.sqrt(enemy.health) * (if future == wave then 1 else 0.35)
                total += weight
                if enemy.hidden then hidden += weight end
                if enemy.flying then flying += weight end
                if enemy.lead then lead += weight end
            end
        end
        result[wave] = {hidden = hidden / math.max(1, total), flying = flying / math.max(1, total), lead = lead / math.max(1, total)}
    end
    return result
end
function StrategyModel.power(stage: any, wave: number, policy: any, spectrum: any?): number
    local damage = stage.dps + stage.unitDps * math.clamp((wave - 3) / 8, 0, 1)
    if spectrum then
        if not stage.hidden then damage *= 1 - spectrum.hidden end
        if not stage.flying then damage *= 1 - spectrum.flying end
        if not stage.lead then damage *= 1 - spectrum.lead end
    else
        if wave >= 7 and not stage.hidden then damage *= policy.hiddenPenalty end
        if wave >= 20 and not stage.flying then damage *= 0.9 end
    end
    if stage.splash > 0 then damage *= 1 + math.min(2, stage.splash / 5) * math.min(1, wave / 15) end
    if (stage.pierce or 1) > 1 then damage *= 1 + 0.45 * (stage.pierce - 1) * math.min(1, wave / 12) end
