local function plannerCalculate(startAfter: boolean?)
    assert(not planner.busy, "A strategy search is already running.")
    plannerStop()
    planner.plan = nil
    local token = planner.token
    planner.busy = true
    task.spawn(function()
        local ok, problem = pcall(function()
            local model = plannerModel(token)
            local candidates = plannerPolicies(model)
            local deadline = if planner.limitSearchTime then os.clock() + planner.seconds else math.huge
            local best: any = nil
            local tested = 0
            local stopReason = "strategy_limit"
            for index, policy in ipairs(candidates) do
                if best and os.clock() >= deadline then stopReason = "time_limit"; break end
                plannerMessage("Searching strategy " .. index .. "/" .. #candidates .. "...\nBest tested wave: " .. tostring(best and best.result.reached or 0))
                local candidateWon = false
                local function checkpoint()
                    plannerCheck(token)
                    if best and not candidateWon and os.clock() >= deadline then error("STRATEGY_SEARCH_BUDGET", 0) end
                end
                local completed, result, stressed = pcall(function()
                    local baseline = StrategyModel.simulate(model, policy, {damage = 0.78, health = 1.05, speed = 1.03, stun = 1, seed = 7, bossRoute = 1}, checkpoint)
                    candidateWon = baseline.won
                    if baseline.won then plannerMessage("Strategy " .. index .. " won the baseline simulation. Checking this plan's stress outcome...") end
                    local worst = StrategyModel.simulate(model, policy, {damage = 0.6, health = 1.2, speed = 1.1, stun = 1.3, seed = 31, bossRoute = model.stressBossRoute}, checkpoint)
                    candidateWon = candidateWon or worst.won
                    local bossRoutes = {model.stressBossRoute}
                    if worst.reached == #model.profile.waves then
                        for route in ipairs(model.routes) do
                            if route == model.stressBossRoute then continue end
                            local variant = StrategyModel.simulate(model, policy, {damage = 0.6, health = 1.2, speed = 1.1, stun = 1.3, seed = 31, bossRoute = route}, checkpoint)
                            table.insert(bossRoutes, route)
                            if StrategyModel.rank(variant, variant) < StrategyModel.rank(worst, worst) then worst = variant end
                        end
                    end
                    worst.bossRoutesEvaluated = bossRoutes
                    return baseline, worst
                end)
                if not completed then if tostring(result):find("STRATEGY_SEARCH_BUDGET", 1, true) then stopReason = "time_limit"; break else error(result, 0) end end
                tested += 1
                local score = StrategyModel.rank(result, stressed)
                if not best or score > best.score then best = {model = model, policy = policy, result = result, stress = stressed, score = score} end
                if result.won or stressed.won then stopReason = "winning_plan"; break end
            end
            assert(best, "The search did not complete a simulation.")
            best.searched = tested
            best.strategyLimit = #candidates
            best.stopReason = stopReason
            assert(token == planner.token, "Planning cancelled.")
            planner.plan = best
            planner.busy = false
            best.roster, best.considered = {}, {}
            for _, def in ipairs(model.defs) do best.considered[def.name] = true end
            for _, action in ipairs(best.result.actions) do if action.kind == "place" then best.roster[action.name] = (best.roster[action.name] or 0) + 1 end end
            local roster = {}
            for name, amount in pairs(best.roster) do table.insert(roster, name .. " x" .. amount) end
            table.sort(roster)
            plannerSave()
            local result = best.result
            local message = string.format("%s\nSearched %d policies. Baseline reached wave %d (%s); stress test reached %d (%s).\n%s\nThis is a simulation estimate from one recording, not a measured win rate.", if result.won or best.stress.won then "A simulated winning strategy was found." else "No simulated win found; selected the farthest-wave strategy.", tested, result.reached, if result.won then "win" else "loss", best.stress.reached, if best.stress.won then "win" else "loss", if #model.warnings > 0 then table.concat(model.warnings, "\n") else "Direct tower models available for this loadout.")
            plannerMessage(message .. "\nSearch stopped: " .. (if stopReason == "winning_plan" then "first simulated win" else if stopReason == "time_limit" then "optional time limit reached" else "strategy limit reached") .. " (" .. tested .. "/" .. #candidates .. ").\nPlanned purchases: " .. (if #roster > 0 then table.concat(roster, ", ") else "none affordable in this simulation") .. "\n" .. (best.policy.label or "Tower focus") .. " | " .. #model.routes .. " routes | " .. model.scheduled .. " scheduled enemies")
            if startAfter then plannerBegin() end
        end)
        if token == planner.token then
            planner.busy = false
            if not ok then planner.running = false; plannerMessage((tostring(problem):gsub("^.-:%d+: ", ""))) end
        end
    end)
end
local function plannerTowers(model: any): {any}
    local towers = {}
    for _, tower in pairs(TowerReplicator.getTowers()) do
        if tower.OwnerId ~= localPlayer.UserId or not tower.Model or not tower.Model.Parent then continue end
        local name = tower.TowerName or tower.Name
        local level = tonumber(tower.Replicator:Get("Upgrade")) or 0
        local branch = tonumber(tower.Replicator:Get("Path")) or 0
        local intended = planner.owned[tower.Model]
        if branch == 0 and type(intended) == "table" then branch = intended.branch end
        local definition: any = nil
        for _, def in ipairs(model.defs) do if def.name == name and (def.path == branch or not definition) then definition = def end end
        if not definition then continue end
        local point = tower.BottomPosition or tower.Position or tower.Model:GetPivot().Position
        local closest = 1
        local distance = math.huge
        for index, site in ipairs(definition.sites) do local d = (site.point - point).Magnitude; if d < distance then distance = d; closest = index end end
        local upgrade = upgradeRecord(tower, definition.path)
        table.insert(towers, {def = definition, site = closest, level = math.min(level, #definition.stages - 1), live = tower, canUpgrade = upgrade ~= nil, upgradeCost = upgrade and upgrade.cost})
    end
    return towers
end
local function plannerEnemyState(model: any): any
    local enemies = {}
    for _, node in ipairs(Collection:GetTagged("Enemies")) do
        local enemy = plannerNPC.GetNPCFromFolder(node)
        if enemy and enemy.Type == "Enemies" and (tonumber(enemy.Health) or 0) > 0 and tostring(enemy.PathTeam) == tostring(model.team) then
            table.insert(enemies, {live = enemy, distance = tonumber(enemy.PathDistance) or 0, path = enemy.PathName, route = model.routeIndex and model.routeIndex[tostring(enemy.PathName)] or 0})
        end
    end
    return enemies
end
local function plannerRemainingRoutes(model: any, enemies: any): any
    local after = {}
    for index in ipairs(model.routes) do after[index] = math.huge end
    for _, enemy in ipairs(enemies) do
        if enemy.route and enemy.route > 0 then after[enemy.route] = math.min(after[enemy.route], enemy.distance)
        else for index in ipairs(model.routes) do after[index] = math.min(after[index], enemy.distance) end end
    end
    return after
end
local function plannerLog(kind: string, data: any)
    planner.actions += 1
    table.insert(planner.reports, {kind = kind, wave = GameState.Wave, time = workspace:GetServerTimeNow(), sim = planner.sim, scale = GameState.TimeScale, data = data})
