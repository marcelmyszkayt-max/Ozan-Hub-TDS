local function cash(): number
    local player = PlayerReplicator.GetLocalPlayerRaw()
    if not player or not player.Replicator then return 0 end
    return math.max(0, tonumber(player.Replicator:Get("Cash")) or 0)
end
local function levelOf(tower: any): number
    return tonumber(tower.Replicator:Get("Upgrade")) or tonumber(tower.Upgrade) or 0
end
local function upgradeRecord(tower: any, preferredPath: number?): any
    if tower.OwnerId ~= localPlayer.UserId or not tower.Model or not tower.Model.Parent or not tower.Maid then return nil end
    local renderer = tower.StatusEffectRenderer
    if renderer and renderer:has(GameEnum.StatusEffect.Jailed) then return nil end
    local level = levelOf(tower)
    local uid = tostring(tower.UID or tower.Model)
    local key = uid .. ":" .. level
    if (retryAfter[key] or 0) > os.clock() then return nil end
    local stats = tower.Asset and tower.Asset.Stats
    stats = stats and stats[if tower.GoldenPerks then "Golden" else "Default"]
    local nextUpgrade = stats and stats.Upgrades and stats.Upgrades[level + 1]
    if type(nextUpgrade) ~= "table" then return nil end
    local path: number? = nil
    if type(nextUpgrade[1]) == "table" then
        local chosen = tonumber(tower.Replicator:Get("Path")) or 0
        path = if chosen > 0 then chosen else preferredPath or splitPath
        nextUpgrade = nextUpgrade[path]
    end
    if type(nextUpgrade) ~= "table" or type(nextUpgrade.Cost) ~= "number" then return nil end
    local discount = tonumber(tower.DiscountBuff) or 0
    local cost = nextUpgrade.Cost * (1 - discount / 100)
    local scale: any = ReplicatedStorage.State:FindFirstChild("PriceScale")
    if scale then cost *= tonumber(scale.Value) or 1 end
    if GameState.IsModifierEnabled("Inflation") then cost = math.round(cost * 1.5) end
    cost = math.max(0, math.floor(cost * (tonumber(GameRules.Get("UpgradeCostMultiplier")) or 1)))
    return {tower = tower, model = tower.Model, level = level, cost = cost, path = path, uid = uid, key = key}
end
local function upgradeCandidates(budget: number): {any}
    local candidates = {}
    for _, tower in pairs(TowerReplicator.getTowers()) do
        local record = upgradeRecord(tower)
        if record and record.cost <= budget then table.insert(candidates, record) end
    end
    table.sort(candidates, function(a: any, b: any): boolean
        if upgradePriority == "Highest level first" and a.level ~= b.level then return a.level > b.level end
        if upgradePriority == "Cheapest upgrade first" and a.cost ~= b.cost then return a.cost < b.cost end
        if upgradePriority == "Most expensive upgrade first" and a.cost ~= b.cost then return a.cost > b.cost end
        if a.level ~= b.level then return a.level < b.level end
        if a.cost ~= b.cost then return a.cost < b.cost end
        return a.uid < b.uid
    end)
    return candidates
end
local function startUpgrades(automatic: boolean)
    if not alive or Fluent.Unloaded then return end
    if upgradeBusy then
        if not automatic then notify("An upgrade pass is already running.") end
        return
    end
    upgradeBusy = true
    local epoch = upgradeEpoch
    local budget = cash()
    task.spawn(function()
        local purchased = 0
        local rejected = 0
        local ok, issue = pcall(function()
            while alive and not Fluent.Unloaded and (not automatic or (autoUpgrade and epoch == upgradeEpoch)) do
                budget = math.min(budget, cash())
                local nextRecord = upgradeCandidates(budget)[1]
                if not nextRecord then break end
                local tower = nextRecord.tower
                if not alive or Fluent.Unloaded then break end
                if levelOf(tower) ~= nextRecord.level or not nextRecord.model.Parent then continue end
                local success, accepted, reason = pcall(function()
                    return Troops:InvokeServer("Upgrade", "Set", {Troop = nextRecord.model, Path = nextRecord.path})
                end)
                if not alive or Fluent.Unloaded then break end
                if not success or not accepted then
                    rejected += 1
                    lastUpgradeError = tostring(if success then reason or "Upgrade rejected" else accepted)
                    retryAfter[nextRecord.key] = os.clock() + 15
                else
                    budget = math.max(0, budget - nextRecord.cost)
                    purchased += 1
                    local deadline = os.clock() + 3
                    while alive and not Fluent.Unloaded and nextRecord.model.Parent and levelOf(tower) <= nextRecord.level and os.clock() < deadline do
                        task.wait(0.05)
                    end
                    if nextRecord.model.Parent and levelOf(tower) <= nextRecord.level then
                        retryAfter[nextRecord.key] = os.clock() + 15
                        lastUpgradeError = "Waiting for the server to confirm the tower level."
                        break
                    end
                end
                task.wait(0.2)
            end
        end)
        upgradeBusy = false
        if not ok then lastUpgradeError = tostring(issue) end
        if not automatic and alive and not Fluent.Unloaded then
            if not ok then
                notify("Upgrades stopped: " .. tostring(issue))
            elseif rejected > 0 then
                notify("Purchased " .. purchased .. " upgrades. Skipped " .. rejected .. " rejected requests. " .. lastUpgradeError)
            else
                notify("Purchased " .. purchased .. " upgrades with the available budget.")
            end
        end
    end)
end
runtime.onCleanup(function()
    autoUpgrade = false
    upgradeEpoch += 1
    table.clear(retryAfter)
end)
