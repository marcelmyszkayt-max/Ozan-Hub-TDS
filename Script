    return wins * 100000000000 + result.reached * 100000000 + result.cleared * 1000000 + stressed.reached * 10000 + stressed.cleared * 100 + math.clamp(math.min(result.health, stressed.health), 0, 1000) * 0.001 + math.min(9000, result.killed) * 0.000001 - stressed.bossProgress * 0.00001
