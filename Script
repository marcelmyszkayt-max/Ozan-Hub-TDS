    value *= if scale then tonumber(scale.Value) or 1 else 1
    if GameState.IsModifierEnabled("Inflation") then value *= 1.5 end
    return math.max(0, math.floor(value * (tonumber(GameRules.Get("UpgradeCostMultiplier")) or 1)))
end
