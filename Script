local function plannerBegin()
    local plan = planner.plan
    assert(plan and not planner.busy, "Calculate a strategy first.")
    assert(not GameState.GameOver and (tonumber(GameState.Wave) or 0) == 0, "Start this strategy in a fresh match before wave 1.")
    assert(plan.model.map == workspace:FindFirstChild("Map") and plan.model.loadoutKey == plannerLoadoutKey() and plan.model.rulesKey == plannerRulesKey(), "The map, loadout or placement/range rules changed. Calculate again.")
    assert(#plan.model.defs > 0, "There are no usable modeled towers in this loadout.")
    plannerDisableOtherAutomation()
    planner.running = true
    planner.owned = {}
    planner.retry = {}
    planner.reports = {}
    planner.actions = 0
    planner.sim = 0
    planner.wave = -1
