local function initializeHub()
    local deadline = os.clock() + 30
    while not game:IsLoaded() and os.clock() < deadline do task.wait(0.1) end
    assert(game:IsLoaded(), "Roblox has not finished loading. Join a game and execute the script again.")
    local players = game:GetService("Players")
    while not players.LocalPlayer and os.clock() < deadline do task.wait(0.1) end
    assert(players.LocalPlayer, "The local player is not ready. Execute again after joining.")
    local playerGui = players.LocalPlayer:WaitForChild("PlayerGui", 15)
    assert(playerGui, "PlayerGui is not ready.")
    local previousError = playerGui:FindFirstChild("OzanHubStartupError")
    if previousError then previousError:Destroy() end
    local storage = game:GetService("ReplicatedStorage")
    assert(storage:WaitForChild("Client", 20), "The game's Client folder has not replicated yet.")
    assert(storage:WaitForChild("Shared", 20), "The game's Shared folder has not replicated yet.")
    local function trackedRequire(module: any): any
        startupStage = "Loading " .. module:GetFullName()
        return require(module)
    end

local runtime: any = {}
local cleanups: {() -> ()} = {}
local running = true
function runtime.onCleanup(callback: () -> ()) table.insert(cleanups, callback) end
function runtime.stop()
    if not running then return end
    running = false
    for index = #cleanups, 1, -1 do pcall(cleanups[index]) end
    table.clear(cleanups)
end
function runtime.override(object: any, key: any, replacement: any)
    local original = object[key]
    object[key] = replacement
    runtime.onCleanup(function()
        if object[key] == replacement then object[key] = original end
    end)
end
