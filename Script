        local result = tryOffset(lastWallOffset)
        if result then return true, result end
    end
    for _, candidate in ipairs(wallOffsets) do
        if candidate == lastWallOffset then continue end
        local result = tryOffset(candidate)
        if result then return true, result end
    end
    if valid and not sameSurface then return false end
    return valid, hit
end
