local function plannerMessage(message: string)
    if planner.message == message then return end
    planner.message = message
    if plannerStatus then plannerStatus:SetDesc(message) end
end
local function plannerStop(reason: string?)
    planner.token += 1
    planner.running = false
    planner.busy = false
    plannerReleaseVoting()
    if reason then plannerMessage(reason) end
end
local function plannerCheck(token: number)
    assert(alive and not Fluent.Unloaded and planner.token == token, "Planning cancelled.")
    task.wait()
    assert(alive and not Fluent.Unloaded and planner.token == token, "Planning cancelled.")
end
local function plannerLoadoutKey(): string
