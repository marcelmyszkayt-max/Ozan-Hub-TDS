        local routes = {}
        for index in ipairs(model.routes) do table.insert(routes, index) end
        return routes
    end
    if info.spawnOnce or info.boss then return {math.clamp(bossRoute or 1, 1, #model.routes)} end
    return {(ordinal - 1) % #model.routes + 1}
end
function StrategyModel.secondaryHit(stage: any, origin: Vector3, target: Vector3, victim: Vector3): number
    if stage.splash > 0 and (victim - target).Magnitude <= stage.splash then return 1 end
    if (stage.pierce or 1) <= 1 then return 0 end
    local direction = target - origin
    if direction.Magnitude < 0.001 then return 0 end
    direction = direction.Unit
    local delta = victim - origin
    local forward = delta:Dot(direction)
    local width = 1 + math.tan(math.rad(math.clamp(stage.spread or 5, 5, 60) * 0.5)) * forward
