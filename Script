    end
    local action = StrategyModel.action(plan.model.defs, towers, budget, wave, plan.policy, plan.model.routes, tonumber(GameState.GetTowerCount(plan.model.team)) or plan.model.cap, after, {spectra = plan.model.spectra, stacking = enabled, allPaths = plan.model.allPaths, blocked = function(candidate: any) return (planner.retry[actionKey(candidate)] or 0) > os.clock() end})
