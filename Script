    if not planner.running or not plan or not alive or Fluent.Unloaded then return end
    if GameState.GameOver then plannerStop("Match ended. Strategy execution log saved."); plannerSave(); return end
    if plan.model.map ~= workspace:FindFirstChild("Map") or plan.model.loadoutKey ~= plannerLoadoutKey() or plan.model.rulesKey ~= plannerRulesKey() then plannerStop("Map, loadout or placement/range rules changed. Recalculate the strategy."); return end
    if not GameState.GameStarted then
        plannerMessage("Strategy active | waiting for the game's Ready vote or countdown.")
        if planner.autoReady then plannerVote(true) end
        return
    end
    local token = planner.token
    local p = PlayerReplicator.GetLocalPlayerRaw()
    if not p then plannerMessage("Strategy active | waiting for player data."); return end
    local towers = plannerTowers(plan.model)
    local wave = tonumber(GameState.Wave) or 1
    if planner.wave ~= wave then planner.wave = wave; planner.waveStart = planner.sim end
    local budget = cash()
    local enemies = plannerEnemyState(plan.model)
    for _, tower in ipairs(towers) do
