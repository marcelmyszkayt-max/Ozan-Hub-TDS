local function findAdvisorPosition()
    local name = advisorSelected
    assert(name and table.find(advisorLoadout(), name), "Select a tower from the chosen player's loadout first.")
    cancelAdvisor()
    local token = advisorRun
    local sourceId = advisorPlayerId
    advisorBusy = true
    advisorMessage("Searching placement surfaces...")
    task.spawn(function()
        local ok, problem = pcall(function()
            local map = workspace:FindFirstChild("Map")
            local player = advisorSource(sourceId)
            assert(map and player, "The match is not ready yet.")
            local team = player.Team
            local definition = advisorDefinition(name)
            local routes = advisorRoutes(team)
            local allies = advisorAllies(team)
            local surfaces = advisorSurfaces(definition.asset.Properties.Class)
            local searchRange = 0
            for _, stage in ipairs(definition.stages) do searchRange = math.max(searchRange, stage.range) end
            local function current(): boolean
                return alive and not Fluent.Unloaded and advisorRun == token and advisorPlayerId == sourceId and advisorSource(sourceId) == player and tostring(player.Team) == tostring(team) and map.Parent == workspace and workspace:FindFirstChild("Map") == map and advisorSelected == name and table.find(advisorLoadout(sourceId), name) ~= nil and not GameState.GameOver
            end
            local function checkpoint()
                assert(current(), "Search cancelled because the tower or match changed.")
                task.wait()
                assert(current(), "Search cancelled because the tower or match changed.")
            end
            local points, seen = {}, {}
            local function add(x: number, z: number)
                if #points >= 5000 then return end
                local key = math.round(x * 2) .. ":" .. math.round(z * 2)
                if seen[key] then return end
                seen[key] = true
                local point = advisorProject(x, z, surfaces)
                if point then table.insert(points, point) end
            end
            for index, part in ipairs(surfaces.parts) do
                if #points >= 1400 then break end
                for _, offset in ipairs({Vector3.zero, Vector3.new(0.35, 0, 0.35), Vector3.new(-0.35, 0, 0.35), Vector3.new(0.35, 0, -0.35), Vector3.new(-0.35, 0, -0.35)}) do
                    local point = part.CFrame:PointToWorldSpace(Vector3.new(offset.X * part.Size.X, 0, offset.Z * part.Size.Z))
                    add(point.X, point.Z)
                end
                if index % 20 == 0 then checkpoint() end
            end
            for _, route in ipairs(routes) do
                local samples = math.max(12, math.min(math.floor(90 / #routes), math.ceil(route.length / math.max(5, searchRange * 0.35))))
                for index = 0, samples do
                    local point = route.path:GetScalar(route.length * index / samples)
                    add(point.X, point.Z)
                    for _, scale in ipairs({0.4, 0.75, 0.97}) do
                        for angle = 0, 11 do
                            local theta = angle * math.pi / 6
                            add(point.X + math.cos(theta) * searchRange * scale, point.Z + math.sin(theta) * searchRange * scale)
                        end
                    end
                    if index % 3 == 0 then checkpoint() end
                end
            end
            local ranked = {}
            for index, point in ipairs(points) do
                local scored = advisorScore(point, definition, routes, allies)
                if scored.score > 0 then scored.point = point; table.insert(ranked, scored) end
                if index % 30 == 0 then advisorMessage("Scoring " .. index .. " / " .. #points .. " sampled positions..."); checkpoint() end
            end
            table.sort(ranked, function(a, b)
                if a.score ~= b.score then return a.score > b.score end
                if a.point.X ~= b.point.X then return a.point.X < b.point.X end
                return a.point.Z < b.point.Z
            end)
            local best: any = nil
            local checked = 0
            for index = 1, #ranked do
                local candidate = ranked[index]
                local valid = validateAdvisorPoint(name, candidate.point, team)
                checked += 1
                if valid then
                    candidate.request = valid.request
                    best = candidate
                    break
                end
                if index % 8 == 0 then advisorMessage("Checking placement rules: " .. index .. " candidates..."); checkpoint() end
            end
            assert(best, "No valid position was found among the sampled candidates. Check the placement settings, then try again.")
            for _, step in ipairs({1, 0.5}) do
                local centre = best.point
                for x = -2, 2 do
                    for z = -2, 2 do
                        local point = advisorProject(centre.X + x * step, centre.Z + z * step, surfaces)
                        if point then
                            local candidate = advisorScore(point, definition, routes, allies)
                            if candidate.score > best.score + 0.0001 then
                                local valid = validateAdvisorPoint(name, point, team)
                                checked += 1
                                if valid then candidate.point = point; candidate.request = valid.request; best = candidate end
                            end
                        end
                    end
                    checkpoint()
                end
            end
            assert(current(), "The search result is no longer current.")
            best.name = name
            best.map = map
            best.team = team
            best.userId = sourceId
            best.playerName = player.Player.DisplayName .. " (@" .. player.Player.Name .. ")"
            best.range = definition.range
            best.deadzone = definition.deadzone
            best.baseRange = definition.baseRange
            best.targetLevel = definition.targetLevel
            best.price = definition.price
            advisorResult = best
            showAdvisorMarker(best)
            local plan = definition.planning .. " through level " .. definition.targetLevel .. (if definition.branch then " / branch " .. definition.branch else "")
            local summary = string.format("Best searched spot for %s\n%s\nRange: %.1f base -> %.1f planned\nAverage path coverage: %.1f base -> %.1f planned studs\nSampled %d positions; validated %d candidates.\nGreen: planned range. Blue: base range. Places at base level; upgrades are separate.", name, plan, definition.baseRange, definition.range, best.baseCoverage, best.coverage, #points, checked)
            if definition.support then summary = string.format("Best searched support position for %s\n%s\nRange: %.1f base -> %.1f planned\nAllied damage towers covered: %d base -> %d planned\nGreen: planned range. Blue: base range. Places at base level; upgrades are separate.", name, plan, definition.baseRange, definition.range, best.baseAllies, best.allies) end
            summary = best.playerName .. " | " .. definition.variant .. " stats\n" .. summary
            summary ..= string.format("\nMinimum range: %.1f base -> %.1f planned. Red marks the planned dead zone; coverage excludes it.\nPosition: X %.1f, Y %.1f, Z %.1f.", definition.baseDeadzone, definition.deadzone, best.point.X, best.point.Y, best.point.Z)
            if sourceId ~= localPlayer.UserId then summary ..= "\nFriend preview only. Your friend must place the tower; this marker is visible on your client." end
            advisorMessage(summary)
        end)
        if advisorRun == token then
            advisorBusy = false
            if not ok then advisorResult = nil; clearAdvisorMarker(); advisorMessage((tostring(problem):gsub("^.-:%d+: ", ""))) end
        end
    end)
end
local advisorPlacing = false
