    assert(type(paths) == "table", "Wait for the map's enemy paths to finish loading.")
    local routes = {}
    local keys = {}
    for key, route in pairs(paths) do if tonumber(key) and type(route) == "table" and route.Points then table.insert(keys, key) end end
    table.sort(keys, function(a, b) return tonumber(a) < tonumber(b) end)
    for _, key in ipairs(keys) do
        local route = paths[key]
        local segments = {}
        local travelled = 0
        for index = 2, #route.Points do
            local a, b = route.Points[index - 1], route.Points[index]
            if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
                local d = b - a
                local length = d.Magnitude
                if length > 0.001 then table.insert(segments, {a = a, d = d, square = d:Dot(d), length = length, start = travelled}); travelled += length end
            end
        end
        if travelled > 0 then table.insert(routes, {path = route, segments = segments, length = travelled}) end
        if #routes >= 8 then break end
    end
    assert(#routes > 0, "No usable enemy paths were found.")
    return routes
end
local function advisorAllies(team: any): {any}
    local allies = {}
    for _, tower in pairs(TowerReplicator.getTowers()) do
        if tostring(tower.Team) == tostring(team) and tower.Position and (tonumber(tower.Damage) or 0) > 0 then
            table.insert(allies, {position = tower.Position, value = 1 + math.sqrt(math.max(0, (tonumber(tower.Damage) or 0) / math.max(0.05, tonumber(tower.Cooldown) or 1))) * 0.05})
        end
    end
    return allies
end
local function advisorSegmentInterval(square: number, b: number, distanceSquare: number, radius: number): (number, number)
    if radius <= 0 then return 0, 0 end
    local discriminant = b * b - 4 * square * (distanceSquare - radius * radius)
    if discriminant <= 0 then return 0, 0 end
    local root = math.sqrt(discriminant)
    return math.clamp((-b - root) / (2 * square), 0, 1), math.clamp((-b + root) / (2 * square), 0, 1)
end
local function advisorScoreAtRange(point: Vector3, range: number, deadzone: number, definition: any, routes: {any}, allies: {any}): any
    local total, weakest, early = 0, math.huge, 0
    for _, route in ipairs(routes) do
        local covered = 0
        for _, segment in ipairs(route.segments) do
            local f = segment.a - point
            local b = 2 * f:Dot(segment.d)
            local distanceSquare = f:Dot(f)
            local enter, leave = advisorSegmentInterval(segment.square, b, distanceSquare, range)
            if leave > enter then
                local amount = (leave - enter) * segment.length
                local weighted = amount * (1 + 0.35 * (1 - (segment.start + (enter + leave) * 0.5 * segment.length) / route.length))
                if deadzone > 0 then
                    local innerEnter, innerLeave = advisorSegmentInterval(segment.square, b, distanceSquare, math.min(range, deadzone))
                    innerEnter = math.max(enter, innerEnter)
                    innerLeave = math.min(leave, innerLeave)
                    if innerLeave > innerEnter then
                        local blocked = (innerLeave - innerEnter) * segment.length
                        amount -= blocked
                        weighted -= blocked * (1 + 0.35 * (1 - (segment.start + (innerEnter + innerLeave) * 0.5 * segment.length) / route.length))
                    end
                end
                covered += math.max(0, amount)
                early += math.max(0, weighted)
            end
        end
        total += covered
        weakest = math.min(weakest, covered)
    end
    local coverage = total / #routes
    local score = coverage
    if advisorObjective == "Cover every route" then score = weakest + coverage * 0.1 end
    if advisorObjective == "Earlier engagement" then score = early / #routes end
    local count, supportScore = 0, 0
    if definition.support and #allies > 0 then
        for _, ally in ipairs(allies) do
            local distance = (ally.position - point).Magnitude
            if distance <= range and distance >= deadzone then count += 1; supportScore += ally.value end
        end
        score = supportScore * 10000 + score * 0.001
    end
    return {score = score, coverage = coverage, weakest = weakest, allies = count}
end
local function advisorScore(point: Vector3, definition: any, routes: {any}, allies: {any}): any
    local cached = {}
    local function score(stage: any): any
        local key = tostring(stage.range) .. ":" .. tostring(stage.deadzone)
        local scored = cached[key]
        if not scored then
            scored = advisorScoreAtRange(point, stage.range, stage.deadzone, definition, routes, allies)
            cached[key] = scored
        end
        return scored
    end
    local result = score(definition.stages[#definition.stages])
    local base = score(definition.stages[1])
    result.baseCoverage = base.coverage
    result.baseAllies = base.allies
    if definition.planning == "Balanced progression" then
        local total = 0
        for _, stage in ipairs(definition.stages) do
            local scored = score(stage)
            total += scored.score
        end
        result.score = total / #definition.stages
    end
    return result
end
local function advisorSurfaces(class: any): any
    local roots = {}
    if class ~= GameEnum.TowerType.Cliff then
        local ground = workspace:FindFirstChild("Ground")
        if ground then table.insert(roots, ground) end
    end
    if class == GameEnum.TowerType.Cliff or class == GameEnum.TowerType.Both then
        local cliff = workspace:FindFirstChild("Cliff")
        if cliff then table.insert(roots, cliff) end
    end
    assert(#roots > 0, "The map's placement surfaces are not ready.")
    local parts = {}
    local low, high = math.huge, -math.huge
    for _, root in ipairs(roots) do
        for _, part in ipairs(root:GetDescendants()) do
            if part:IsA("BasePart") and part.CanQuery then
                table.insert(parts, part)
                local cf, size = part.CFrame, part.Size
                local halfY = (math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z) / 2
                low = math.min(low, part.Position.Y - halfY)
                high = math.max(high, part.Position.Y + halfY)
            end
        end
    end
    assert(#parts > 0, "No placement surfaces are available for this tower type.")
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = roots
    return {params = params, parts = parts, top = high + 20, depth = high - low + 60}
end
local function advisorProject(x: number, z: number, surfaces: any): Vector3?
    local hit = workspace:Raycast(Vector3.new(x, surfaces.top, z), Vector3.new(0, -surfaces.depth, 0), surfaces.params)
    return hit and hit.Position or nil
end
local function validateAdvisorPoint(name: string, point: Vector3, team: any): any
    local valid, hit = checkHubPlacement(name, point, team, nil, nil, nil)
    if not valid or not hit then return nil end
    local surface = if typeof(hit) == "RaycastResult" then hit.Position else hit.OzanSurfacePosition or hit.Position
    if typeof(surface) ~= "Vector3" or (surface - point).Magnitude > 0.75 then return nil end
    return {request = hit.Position, point = surface}
end
