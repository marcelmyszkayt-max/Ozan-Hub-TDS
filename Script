    end
    if planner.useAbilities then
        local success, problem = pcall(abilitiesStep, true, true)
        if not success then plannerMessage("Ability check: " .. tostring(problem)) end
    end
    local entries = plan.model.profile.waves[math.clamp(wave, 1, finalWave)]
    if #enemies == 0 and planner.sim - planner.waveStart >= entries[#entries][1] + 4 then plannerVote(false) end
end
