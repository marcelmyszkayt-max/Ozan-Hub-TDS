            local boundary = (tower.Replicator and tower.Replicator:Get("EventBoundarySize")) or tower.Asset.Properties.BoundarySize or placementConstants.DEFAULT_BOUNDARY_SIZE
            if quarantine then boundary += 10 end
            table.insert(obstacles, {point, boundary})
        end
    end
